log_ips = [
    "192.168.1.10",
    "185.220.101.1",
    "10.0.0.5",
    "45.33.32.156",
    "172.16.1.1"
]

malicious_ips = [
    "185.220.101.1",
    "45.33.32.156"
]

malicious_count = 0

malicious_count = malicious_count + 1

for ip in log_ips:
    print("Checking:", ip)

    if ip in malicious_ips:
        print("ALERT: Malicious IP detected ->", ip)
        
print("Total malicious IPs found:", malicious_count)

print("Scan Complete")